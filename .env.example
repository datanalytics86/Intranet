# ============================================
# CONFIGURACIÓN DEL PROYECTO HES
# ============================================

# Puerto del servidor
PORT=5000
NODE_ENV=development

# ============================================
# SUPABASE
# ============================================
# Obtener de: https://app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_BUCKET_NAME=hes-archivos

# ============================================
# JWT (Autenticación)
# ============================================
# Generar una clave secreta segura (mínimo 32 caracteres)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# EMAIL (Nodemailer)
# ============================================

# Opción 1: Gmail
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu-app-password
EMAIL_FROM=tu-email@gmail.com

# Opción 2: Resend (recomendado)
# EMAIL_SERVICE=resend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=resend
# EMAIL_PASSWORD=re_xxxxxxxxxxxx
# EMAIL_FROM=Sistema HES <noreply@tudominio.com>

# Opción 3: Otro SMTP
# EMAIL_SERVICE=custom
# EMAIL_HOST=smtp.tuservidor.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=tu-usuario
# EMAIL_PASSWORD=tu-contraseña
# EMAIL_FROM=noreply@tudominio.com

# ============================================
# NOTAS DE CONFIGURACIÓN
# ============================================

# Para Gmail:
# 1. Activar verificación en 2 pasos
# 2. Generar una "Contraseña de aplicación"
# 3. Usar esa contraseña en EMAIL_PASSWORD

# Para Resend:
# 1. Crear cuenta en https://resend.com
# 2. Obtener API key
# 3. Configurar dominio personalizado (opcional)

# Para Supabase:
# 1. Crear proyecto en https://supabase.com
# 2. Ejecutar el script database/schema.sql
# 3. Crear bucket "hes-archivos" en Storage
# 4. Configurar políticas de acceso
